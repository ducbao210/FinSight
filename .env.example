# Vector database (local ChromaDB)
CHROMA_PERSIST_DIR=data/index/chroma
CHROMA_COLLECTION=finsight_chunks
CHROMA_UPSERT_RETRIES=3

# LLM API
GROQ_API_KEY=

# Model name
MODEL_NAME=openai/gpt-oss-120b

# HF TOKEN
HF_TOKEN=

# Embedding model
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Reranker model
RERANKER_MODEL=BAAI/bge-reranker-base
USE_RERANKER=false

# Retrieval
TOP_K_DENSE=30
TOP_K_BM25=30
TOP_K_HYBRID=12

# CRAG
MAX_RETRIES=2
MAX_HOPS=2

# Logging
LOG_LEVEL=INFO
LOG_DIR=logs